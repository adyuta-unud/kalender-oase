# ==========================================
# 1. Konfigurasi Akun OASE (SSO Universitas Udayana)
# ==========================================
# Digunakan untuk mengambil daftar tugas aktif via API resmi Moodle core_calendar_get_action_events_by_timesort
OASE_USERNAME="2408561001"
OASE_PASSWORD="your-sso-password"

# ==========================================
# 2. Google OAuth 2.0 & Calendar API
# ==========================================
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Untuk produksi (Vercel):
# GOOGLE_REDIRECT_URI="https://your-domain.vercel.app/api/auth/google/callback"

# ==========================================
# 3. Pengaturan Aplikasi & Deployment
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Kunci acak 32-karakter untuk menandatangani sesi enkripsi
SESSION_SECRET="your-random-32-byte-secret-key"
# Kunci otentikasi cron endpoint /api/cron/sync
CRON_SECRET="your-random-cron-secret-key"

# ==========================================
# 4. Cloudflare Turnstile CAPTCHA (Gratis & Anti-Bot)
# ==========================================
# Daftar gratis di Cloudflare Dashboard -> Turnstile -> Add Site
# Kosongkan atau abaikan jika ingin menggunakan built-in smart human challenge bawaan
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ==========================================
# 5. Notifikasi WhatsApp Otomatis (Opsional via Fonnte)
# ==========================================
# Dapatkan token gratis di https://fonnte.com -> Device -> View Token
FONNTE_TOKEN=""
# Nomor WhatsApp tujuan notifikasi (contoh: 081234567890 atau 6281234567890)
FONNTE_TARGET_PHONE=""
# ID Grup WhatsApp tujuan notifikasi (contoh: 123123123@g.us, set "false" jika tidak ingin mengirim ke grup)
FONNTE_GROUP_ID=""

